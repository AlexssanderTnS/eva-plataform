Options -Indexes

<FilesMatch "^(error_log|teste-smtp\.php|test-database\.php|test-users\.php|.*\.(log|bak|old|swp))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
